<!doctype html>
<html lang="{{ .Labels.HTMLLang }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ .Label }} ({{ .Object.APIName }})</title>
	{{ template "styles" . }}
</head>
<body>
	<main>
		<p><a href="index.html">{{ .Labels.BackToIndex }}</a></p>

		<h1>
			{{ .Label }}
			(<code>{{ .Object.APIName }}</code>)
		</h1>

		{{ if .DetailURL }}
		<p>
			{{ .Labels.SetupPrefix }}:
			<a href="{{ .DetailURL }}" target="_blank" rel="noopener noreferrer">{{ .Labels.SetupDetails }}</a>
			|
			<a href="{{ .FieldsURL }}" target="_blank" rel="noopener noreferrer">{{ .Labels.SetupFields }}</a>
		</p>
		{{ end }}

		<h2>{{ .Labels.ObjectDetails }}</h2>

		<table>
			<tbody>
				<tr>
					<th>{{ .Labels.APIName }}</th>
					<td><code>{{ .Object.APIName }}</code></td>
				</tr>
				<tr>
					<th>{{ .Labels.Label }}</th>
					<td>{{ .Object.Label }}</td>
				</tr>
				<tr>
					<th>{{ .Labels.PluralLabel }}</th>
					<td>{{ .Object.PluralLabel }}</td>
				</tr>
				<tr>
					<th>{{ .Labels.DeploymentStatus }}</th>
					<td>{{ .Object.DeploymentStatus }}</td>
				</tr>
				<tr>
					<th>{{ .Labels.SharingModel }}</th>
					<td>{{ .Object.SharingModel }}</td>
				</tr>
				<tr>
					<th>{{ .Labels.Activities }}</th>
					<td>{{ enabledText .Object.EnableActivities .Labels }}</td>
				</tr>
				<tr>
					<th>{{ .Labels.Reports }}</th>
					<td>{{ enabledText .Object.EnableReports .Labels }}</td>
				</tr>
				<tr>
					<th>{{ .Labels.TrackFieldHistory }}</th>
					<td>{{ enabledText .Object.EnableHistory .Labels }}</td>
				</tr>
			</tbody>
		</table>

		<h2>{{ .Labels.Fields }}</h2>

		{{ if .Fields }}
		<div class="table-wrapper">
			<table>
				<thead>
					<tr>
						<th>{{ .Labels.Label }}</th>
						<th>{{ .Labels.APIName }}</th>
						<th>{{ .Labels.TypeAndDetails }}</th>
						{{ range .FlagLabels }}
						<th>{{ . }}</th>
						{{ end }}
						<th>{{ .Labels.Formula }}</th>
					</tr>
				</thead>
				<tbody>
					{{ range .Fields }}
					<tr>
						<td>{{ .Definition.Label }}</td>
						<td><code>{{ .Definition.APIName }}</code></td>
						<td>
							<code>{{ .Definition.Type }}</code>

							{{ if .Details }}
							<ul class="details">
								{{ range .Details }}
								<li>
									{{ .Label }}:
									{{ if .References }}
									{{ range .References }}
									<span class="reference">
										{{ if .URL }}
										<a href="{{ .URL }}">{{ .APIName }}</a>
										{{ else }}
										<code>{{ .APIName }}</code>
										{{ end }}
									</span>
									{{ end }}
									{{ else }}
									{{ .Value }}
									{{ end }}
								</li>
								{{ end }}
							</ul>
							{{ end }}
						</td>
						{{ range .Flags }}
						<td>
							{{ if .Enabled }}
							<span class="badge">{{ .Label }}</span>
							{{ else }}
							—
							{{ end }}
						</td>
						{{ end }}
						<td>
							{{ if .Definition.Formula }}
							<code class="formula">{{ .Definition.Formula }}</code>
							{{ else }}
							—
							{{ end }}
						</td>
					</tr>
					{{ end }}
				</tbody>
			</table>
		</div>
		{{ else }}
		<p>{{ .Labels.NoFields }}</p>
		{{ end }}
	</main>
</body>
</html>
